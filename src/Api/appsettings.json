{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=E_Commerce;Integrated Security=SSPI;TrustServerCertificate=True;Connection Timeout=30;"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "tableName": "Logs",
          "autoCreateSqlTable": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ApplicationSettings": {
    "AppName": "E_Commerce",
    "Version": "1.0.0",
    "Environment": "Development"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "Issuer": "E_CommerceIssuer",
    "Audience": "E_CommerceAudience",
    "Key": "13215149814ddf4984",
    "ExpireMinutes": "60"
  }
}
